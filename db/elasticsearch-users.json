{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "properties": {
      "id": { "type": "long" },
      "created_at": { "type": "date", "format": "yyyy-MM-dd HH:mm:ss.SSSSSS" },
      "created_by": { "type": "keyword" },
      "email_address": { "type": "keyword", "normalizer": "lowercase" },
      "first_name": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
      "last_name": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
      "updated_at": { "type": "date", "format": "yyyy-MM-dd HH:mm:ss.SSSSSS" },
      "updated_by": { "type": "keyword" }
    }
  }
}
